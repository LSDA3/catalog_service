# Catalog Service · environment variable reference
#
# This file contains placeholders and non-secret defaults only.
# Never commit real credentials.
#
# The application reads configuration from the process environment.
# This file is documentation: the project does not automatically load `.env`
# or `.env.example` files.

# ---------------------------------------------------------------------------
# Catalog Service runtime
# ---------------------------------------------------------------------------
# Local development: define these in the shell/process environment before
# starting the service.
# Production: configure them as Fly Secrets.
#
# CATALOG_API_KEY authenticates the five public catalog operations.
# DIAGNOSTICS_API_KEY authenticates the separate operator diagnostics surface.
# The credentials are intentionally different and are not interchangeable.

CATALOG_API_KEY=replace-with-a-catalog-key
DIAGNOSTICS_API_KEY=replace-with-a-diagnostics-key


# ---------------------------------------------------------------------------
# Semantic construction
# ---------------------------------------------------------------------------
# These settings belong to scripts/enrich.py and scripts/relate.py. They are not
# required by the deployed Catalog Service runtime.
#
# ANTHROPIC_API_KEY is required when running the model-backed semantic
# construction. In CI it is configured as a GitHub Actions repository secret.
#
# ENRICH_MODEL and RELATE_MODEL are optional model overrides. If they are absent,
# both scripts currently default to claude-sonnet-4-5.

ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
ENRICH_MODEL=claude-sonnet-4-5
RELATE_MODEL=claude-sonnet-4-5


# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
# FLY_API_TOKEN is used by GitHub Actions to deploy the application to Fly.io.
# Configure it as a GitHub Actions repository secret. It is not required by the
# Catalog Service process itself and should not be placed in the Fly runtime.

FLY_API_TOKEN=replace-with-your-fly-api-token
